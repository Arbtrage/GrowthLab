# =============================================================================
# GrowthLab environment variables
# Copy to .env.local and fill in values. Never commit .env.local.
# =============================================================================

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — Project Settings → Database → Connection string → Transaction pooler (port 6543)
# Copy the entire URI tab value. Do NOT use the anon/service_role keys here.
# Do NOT edit the password manually — if it contains @, #, or %, Supabase encodes it for you.
DATABASE_URL=

# Google AI Studio — https://aistudio.google.com/apikey
# Powers LeetCode suggestions, SD editions/feedback, and AI chat (Gemini 3 Lite only)
GEMINI_API_KEY=

# Optional — Mem0 memory layer for AI chat
MEM0_API_KEY=

# Resend — https://resend.com (optional; required for email notifications)
RESEND_API_KEY=
RESEND_FROM_EMAIL=GrowthLab <onboarding@resend.dev>

# Cron — shared secret for POST /api/cron/* (GitHub Actions → Vercel)
CRON_SECRET=

# Public app URL — used for Open Graph metadata and GitHub Actions cron targets
# Local: http://localhost:3000  |  Production: https://your-app.vercel.app
APP_URL=http://localhost:3000
